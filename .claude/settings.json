{
  "extraKnownMarketplaces": {
    "expx-local": {
      "source": {
        "source": "directory",
        "path": "./.expx/marketplace"
      }
    }
  },
  "enabledPlugins": {
    "expx@expx-local": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/expx-lembrete.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/expx-session-sync.mjs"
            ]
          }
        ]
      }
    ]
  }
}
